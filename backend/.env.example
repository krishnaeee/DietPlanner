# Copy to .env and fill in. The .env file is gitignored — never commit your key.

# Which LLM vendor to use: anthropic (default) or gemini. Switch the whole app
# by changing this one line — you only need the key for the provider you pick.
# PROVIDER=anthropic

# Provider API keys (set the one matching PROVIDER above; the other can be blank).
# The proxy keeps these off the mobile client.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# Optional overrides
PORT=3000
# MODEL=                       # override the active provider's default model.
#                              #   anthropic default: claude-opus-4-8
#                              #     (or claude-sonnet-4-6 / claude-haiku-4-5)
#                              #   gemini default: gemini-2.5-flash
#                              #     (or gemini-2.5-flash-lite / gemini-flash-latest)
# EFFORT=medium                # low | medium | high | max (Anthropic only; Gemini ignores it)
# MAX_TOKENS=32000
# MAX_PLAN_DAYS=14             # max days detailed per generation

# Database — Neon Postgres connection string (use the POOLED connection).
# Get it from the Neon dashboard → your project → Connection Details.
# Looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Auth token signing secret (generate: node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\")
JWT_SECRET=change-me

# Google login: WEB OAuth client ID from Google Cloud Console (xxxx.apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=

# ── Billing ────────────────────────────────────────────────────────────────
# Payment provider: mock (default, no keys, fulfils instantly — for dev) or stripe.
# BILLING_PROVIDER=mock
# Currency for prices (usd | inr | eur | gbp | aud | cad). Default usd.
# BILLING_CURRENCY=usd
# Free credits granted to each new account. Default 3.
# SIGNUP_FREE_CREDITS=3
# Override any product price (in the currency's smallest unit, e.g. cents/paise):
# BILLING_PRICE_SINGLE=99
# BILLING_PRICE_PACK_10=699
# BILLING_PRICE_PACK_30=1499
# BILLING_PRICE_SUB_MONTHLY=999

# Stripe (only needed when BILLING_PROVIDER=stripe). Run: npm install stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen` / the dashboard
# PUBLIC_BASE_URL=https://your-backend.example.com   # for checkout return URLs

# RevenueCat (BILLING_PROVIDER=revenuecat) — the path for App Store / Play Store
# in-app purchases. Purchases happen natively in the app; RevenueCat validates
# the receipt and calls our webhook to grant credits / activate the sub.
#   1. Configure store products with ids matching the catalog:
#        single, pack_10, pack_30, sub_monthly
#      (single/pack_* = Consumable; sub_monthly = Auto-renewable subscription)
#   2. Add a webhook in the RevenueCat dashboard pointing at
#        <PUBLIC_BASE_URL>/api/billing/revenuecat/webhook
#      and set its Authorization header to the secret below.
# REVENUECAT_WEBHOOK_AUTH=some-long-random-secret
# REVENUECAT_PRODUCT_MAP={"com.you.diet.single":"single"}   # only if store ids differ
