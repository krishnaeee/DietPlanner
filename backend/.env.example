# Copy to .env and fill in. The .env file is gitignored — never commit your key.

# Which LLM vendor to use: anthropic (default) or gemini. Switch the whole app
# by changing this one line — you only need the key for the provider you pick.
# PROVIDER=anthropic

# Provider API keys (set the one matching PROVIDER above; the other can be blank).
# The proxy keeps these off the mobile client.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# Optional overrides
PORT=3000
# MODEL=                       # override the active provider's default model.
#                              #   anthropic default: claude-opus-4-8
#                              #     (or claude-sonnet-4-6 / claude-haiku-4-5)
#                              #   gemini default: gemini-2.5-flash
#                              #     (or gemini-2.5-flash-lite / gemini-flash-latest)
# EFFORT=medium                # low | medium | high | max (Anthropic only; Gemini ignores it)
# MAX_TOKENS=32000
# MAX_PLAN_DAYS=14             # max days detailed per generation

# Auth token signing secret (generate: node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\")
JWT_SECRET=change-me

# Google login: WEB OAuth client ID from Google Cloud Console (xxxx.apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=
