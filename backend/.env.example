# Copy to .env and fill in. The .env file is gitignored — never commit your key.

# Required: your Anthropic API key (the whole point of the proxy is to keep this
# off the mobile client).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=3000
# MODEL=claude-opus-4-8        # or claude-sonnet-4-6 / claude-haiku-4-5 for cheaper/faster
# EFFORT=medium                # low | medium | high | max
# MAX_TOKENS=32000
# MAX_PLAN_DAYS=14             # max days detailed per generation

# Auth token signing secret (generate: node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\")
JWT_SECRET=change-me

# Google login: WEB OAuth client ID from Google Cloud Console (xxxx.apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=
